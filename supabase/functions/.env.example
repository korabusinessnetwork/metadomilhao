# Copie para supabase/functions/.env (local) ou cadastre como secrets no projeto (produção):
#   supabase secrets set --env-file supabase/functions/.env
# Nunca commite o .env com valores.
ANTHROPIC_API_KEY=
CRON_SEGREDO=
ORIGEM_APP=http://localhost:5180
MODELO_REVISAO=claude-haiku-5-5
MAX_TOKENS_SAIDA=8000
MAX_BUSCAS=5
TETO_MENSAL_CENTAVOS=3000
ESFORCO=low
# Preços em dólar (conferir na página de preços da Anthropic antes de ativar) e cotação para converter em reais
PRECO_ENTRADA_USD_MTOK=0.10
PRECO_SAIDA_USD_MTOK=0.50
PRECO_BUSCA_USD=0.01
COTACAO_USD_BRL=5.60
# Só para testes locais com a API falsa (scripts/api-falsa-anthropic.mjs)
# ANTHROPIC_BASE_URL=http://host.docker.internal:8787
